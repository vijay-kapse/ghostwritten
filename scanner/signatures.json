{
  "schema": 1,
  "version": "2026-11-01",
  "flags": "im",
  "trailer_line": "^[ \\t>*-]*co-authored-by:[ \\t]*(.+)$",
  "order": [
    "merge",
    "automation",
    "ai",
    "human"
  ],
  "notes": [
    "merge: commit has 2+ parents; excluded from the denominator.",
    "automation: author login or name is in `automation`, or the author login ends with [bot] and is not in `agent_bots`; excluded from numerator and denominator.",
    "ai: any rule matches. trailer patterns apply to the value of each line matching trailer_line; body to the whole message; subject to the first line; names to author/committer git names; logins are exact (lowercase) against author/committer login and git name.",
    "A commit can match several rules; by_rule counts each, so sum(by_rule) >= ai."
  ],
  "automation": [
    "all-contributors[bot]",
    "allcontributors[bot]",
    "autofix-ci[bot]",
    "bors[bot]",
    "changeset-bot[bot]",
    "crowdin-bot",
    "deepsource-autofix[bot]",
    "dependabot",
    "dependabot-preview[bot]",
    "dependabot[bot]",
    "dependency-update-bot",
    "electron-roller[bot]",
    "github-actions",
    "github-actions[bot]",
    "greenkeeper[bot]",
    "hosted weblate",
    "imgbot[bot]",
    "kodiakhq[bot]",
    "lingohub[bot]",
    "mergify[bot]",
    "octokitbot",
    "pre-commit-ci[bot]",
    "pyup-bot",
    "pyup.io bot",
    "release-please[bot]",
    "renovate-bot",
    "renovate[bot]",
    "renovatebot",
    "semantic-release-bot",
    "snyk-bot",
    "stainless-app[bot]",
    "stainless-bot",
    "svc-renovate",
    "transifex-integration[bot]",
    "trunk-io[bot]",
    "weblate"
  ],
  "unlisted_bot_is_automation": true,
  "agent_bots": {
    "amazon-q-developer[bot]": "Amazon Q Developer",
    "chatgpt-codex-connector[bot]": "Codex",
    "claude[bot]": "Claude",
    "codegen-sh[bot]": "Codegen",
    "coderabbitai[bot]": "CodeRabbit",
    "copilot": "GitHub Copilot",
    "copilot-pull-request-reviewer[bot]": "GitHub Copilot",
    "copilot-swe-agent[bot]": "GitHub Copilot",
    "cursor[bot]": "Cursor",
    "devin-ai-integration[bot]": "Devin",
    "factory-droid[bot]": "Factory",
    "gemini-code-assist[bot]": "Gemini Code Assist",
    "github-copilot[bot]": "GitHub Copilot",
    "google-labs-jules[bot]": "Jules",
    "openhands-agent[bot]": "OpenHands",
    "sweep-ai[bot]": "Sweep",
    "tembo-io[bot]": "Tembo"
  },
  "rules": [
    {
      "id": "claude_trailer",
      "tool": "Claude",
      "description": "Co-authored-by trailer with an @anthropic.com address, claude[bot], or the name Claude Code",
      "trailer": [
        "@anthropic\\.com",
        "\\bclaude\\[bot\\]",
        "\\bclaude[ -]?code\\b"
      ]
    },
    {
      "id": "claude_generated",
      "tool": "Claude",
      "description": "Footer 'Generated with [Claude Code]' / 'Generated by [Claude Code]' (any line wrapping)",
      "body": [
        "generated\\s+(with|by)\\s+\\[?claude\\s+code\\b"
      ]
    },
    {
      "id": "copilot_trailer",
      "tool": "GitHub Copilot",
      "description": "Co-authored-by trailer mentioning copilot; a Copilot-Session trailer; the footer 'Authored with GitHub Copilot'",
      "trailer": [
        "copilot"
      ],
      "body": [
        "^[ \\t]*copilot-session:[ \\t]*\\S",
        "authored with github copilot"
      ]
    },
    {
      "id": "copilot_author",
      "tool": "GitHub Copilot",
      "description": "Author or committer login is a Copilot agent account",
      "logins": [
        "copilot-swe-agent[bot]",
        "copilot",
        "github-copilot[bot]",
        "copilot-pull-request-reviewer[bot]"
      ]
    },
    {
      "id": "codex_trailer",
      "tool": "Codex",
      "description": "Co-authored-by trailer mentioning codex, or a noreply@openai.com address",
      "trailer": [
        "\\bcodex\\b",
        "noreply@openai\\.com",
        "chatgpt-codex-connector"
      ]
    },
    {
      "id": "cursor",
      "tool": "Cursor",
      "description": "Cursor agent trailer, identity or bot (cursoragent, Cursor Agent, @cursor.com, cursor[bot])",
      "trailer": [
        "cursoragent",
        "\\bcursor agent\\b",
        "@cursor\\.com",
        "\\bcursor\\[bot\\]"
      ],
      "body": [
        "\\bcursoragent@cursor\\.com\\b"
      ],
      "names": [
        "^cursor agent$",
        "^cursoragent$"
      ],
      "logins": [
        "cursor[bot]"
      ]
    },
    {
      "id": "devin",
      "tool": "Devin",
      "description": "Author/committer devin-ai-integration[bot], or a Devin AI trailer",
      "trailer": [
        "devin-ai-integration",
        "\\bdevin ai\\b"
      ],
      "logins": [
        "devin-ai-integration[bot]"
      ]
    },
    {
      "id": "gemini",
      "tool": "Gemini / Jules",
      "description": "gemini-code-assist, google-labs-jules[bot] or gemini-cli as author or trailer",
      "trailer": [
        "gemini-code-assist",
        "google-labs-jules",
        "gemini-cli"
      ],
      "logins": [
        "gemini-code-assist[bot]",
        "google-labs-jules[bot]"
      ]
    },
    {
      "id": "aider",
      "tool": "Aider",
      "description": "Subject starts with 'aider:', an aider trailer, or a git identity ending in '(aider)'",
      "trailer": [
        "\\baider\\b"
      ],
      "subject": [
        "^aider:\\s"
      ],
      "names": [
        "\\(aider\\)\\s*$"
      ]
    },
    {
      "id": "openhands",
      "tool": "OpenHands",
      "description": "openhands or all-hands in a trailer or the git identity",
      "trailer": [
        "openhands",
        "all-hands\\.dev",
        "\\ball-hands\\b"
      ],
      "names": [
        "^openhands\\b"
      ],
      "logins": [
        "openhands-agent[bot]"
      ]
    },
    {
      "id": "amp_factory",
      "tool": "Amp / Factory",
      "description": "Amp (amp-ai, Sourcegraph Amp, @ampcode.com) or Factory (factory-droid) trailer or bot",
      "trailer": [
        "amp-ai",
        "sourcegraph amp",
        "@ampcode\\.com",
        "factory-droid"
      ],
      "logins": [
        "factory-droid[bot]"
      ]
    },
    {
      "id": "other_bot_agent",
      "tool": "Other agent bot",
      "description": "Author login is an AI agent bot on the explicit AGENT_BOTS allowlist (not already claimed by a rule above)",
      "logins": [
        "amazon-q-developer[bot]",
        "chatgpt-codex-connector[bot]",
        "claude[bot]",
        "codegen-sh[bot]",
        "coderabbitai[bot]",
        "sweep-ai[bot]",
        "tembo-io[bot]"
      ]
    }
  ]
}
